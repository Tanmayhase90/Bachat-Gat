PORT=5000
NODE_ENV=development

# Must match the secret used to generate licence keys.
LICENSE_SIGNING_SECRET=replace-with-a-long-random-secret

# Firebase Admin configuration
# Use GOOGLE_APPLICATION_CREDENTIALS for a service-account JSON file, or provide
# FIREBASE_SERVICE_ACCOUNT_JSON as a single-line JSON value.
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
