rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function hasRole(role) {
      return signedIn() && (
        profile().role == role ||
        profile().role_name == role
      );
    }

    function isAdmin() {
      return hasRole('admin') ||
        hasRole('ADMIN') ||
        (signedIn() && (
          request.auth.token.email == 'admin@bachatgat.com' ||
          request.auth.token.email == 'admin2@bachatgat.com' ||
          request.auth.token.email == 'hasetanmay90@gmail.com'
        ));
    }

    function managesMembers() {
      return isAdmin() || hasRole('secretary') || hasRole('SECRETARY');
    }

    function managesMoney() {
      return isAdmin() || hasRole('treasurer') || hasRole('TREASURER');
    }

    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        resource.data.role in ['member', 'MEMBER'] ||
        resource.data.role_name in ['member', 'MEMBER']
      );
      allow list: if signedIn() && (
        isAdmin() ||
        resource.data.role in ['member', 'MEMBER'] ||
        resource.data.role_name in ['member', 'MEMBER']
      );
      allow create: if signedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && (
          request.resource.data.role in ['member', 'MEMBER'] ||
          request.resource.data.role_name in ['member', 'MEMBER']
        ))
      );
      allow update: if signedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /members/{memberId} {
        allow read: if signedIn();
        allow create: if managesMembers() || (
          signedIn() && request.resource.data.authUid == request.auth.uid
        );
        allow update: if managesMembers() || (
          signedIn() && resource.data.authUid == request.auth.uid
        );
        allow delete: if managesMembers();
      }

      match /monthly_contributions/{contributionId} {
        allow read: if signedIn();
        allow write: if managesMoney();
      }

      match /loans/{loanId} {
        allow read: if signedIn();
        allow write: if managesMoney();
      }

      match /repayments/{repaymentId} {
        allow read: if signedIn();
        allow write: if managesMoney();
      }

      match /settlements/{settlementId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      match /activities/{activityId} {
        allow read: if signedIn();
        allow write: if managesMembers() || managesMoney();
      }

      match /notifications/{notificationId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      match /system/member_counter {
        allow read: if signedIn();
        allow write: if managesMembers();
      }

      match /system/{documentId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    match /{legacyCollection}/{documentId} {
      allow read: if signedIn() && legacyCollection in [
        'members', 'savings', 'loans', 'repayments',
        'notifications', 'activities', 'activityLogs',
        'monthlyContributions', 'transactions'
      ];
      allow write: if isAdmin() && legacyCollection in [
        'members', 'savings', 'loans', 'repayments',
        'notifications', 'activities', 'activityLogs',
        'monthlyContributions', 'transactions'
      ];
    }
  }
}
